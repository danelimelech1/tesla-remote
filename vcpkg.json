{
  "name": "tesla-remote",
  "version": "1.0.0",
  "description": "Tesla-themed TeamViewer-like screen sharing (C++ / Boost.Asio / ImGui)",
  "dependencies": [
    {
      "name": "boost-asio"
    },
    {
      "name": "boost-system"
    },
    {
      "name": "glfw3"
    },
    {
      "name": "imgui",
      "features": [
        "glfw-binding",
        "opengl3-binding"
      ]
    },
    {
      "name": "stb"
    }
  ]
}
